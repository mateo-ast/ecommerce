<link rel="stylesheet" href="/css/cart.css">

<section class="cart-page" aria-labelledby="cart-title">
  <div class="cart-shell">
    <header class="cart-header">
      <div>
        <p class="eyebrow">Mi compra</p>
        <h1 id="cart-title">Carrito</h1>
      </div>
      <div class="cart-utility" aria-label="Buscador de productos">
        <label class="sr-only" for="cart-search">Buscar</label>
        <input id="cart-search" type="search" name="search" placeholder="Buscar productos" />
      </div>
    </header>

    <% if (items.length) { %>
      <div class="cart-layout">
        <section class="cart-items" aria-label="Listado de productos del carrito">
          <% items.forEach((item) => { %>
            <article class="cart-item" data-item-id="<%= item.id %>" aria-label="Producto <%= item.name %>">
              <img src="<%= item.image %>" alt="Imagen de <%= item.name %>" />

              <div class="cart-item-info">
                <h2><%= item.name %></h2>
                <p class="cart-item-price"><%= new Intl.NumberFormat('es-AR').format(item.price) %> puntos</p>
              </div>

              <div class="quantity-controls" aria-label="Cantidad de <%= item.name %>">
                <button type="button" aria-label="Reducir cantidad de <%= item.name %>" class="qty-button" data-action="decrement">−</button>
                <span class="quantity-value"><%= item.quantity %></span>
                <button type="button" aria-label="Aumentar cantidad de <%= item.name %>" class="qty-button" data-action="increment">+</button>
              </div>

              <p class="item-total" aria-label="Total para <%= item.name %>"><%= new Intl.NumberFormat('es-AR').format(item.price * item.quantity) %> pts</p>
            </article>
          <% }) %>
        </section>

        <aside class="cart-summary" aria-label="Resumen del pedido">
          <h2>Resumen</h2>

          <div class="summary-row">
            <span>Subtotal</span>
            <strong><%= subtotal %> pts</strong>
          </div>

          <div class="summary-row discount-row">
            <span>Descuento</span>
            <strong>- <%= discount %> pts</strong>
          </div>

          <div class="summary-row total-row">
            <span>Total</span>
            <strong><%= total %> pts</strong>
          </div>

          <div class="cart-actions">
            <a class="button primary" href="/checkout">Ir a Pagar</a>
            <form action="/cart/clear" method="post">
              <button class="button secondary" type="submit">Vaciar carrito</button>
            </form>
            <a class="button secondary" href="/">Volver al listado</a>
          </div>
        </aside>
      </div>
    <% } else { %>
      <section class="empty-cart" aria-labelledby="empty-cart-title">
        <h2 id="empty-cart-title">Tu carrito está vacío</h2>
        <p>Agregá productos para verlos acá.</p>
        <a class="button primary" href="/">Volver al inicio</a>
      </section>
    <% } %>
  </div>
</section>

<script>
  document.querySelectorAll('.qty-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const article = button.closest('.cart-item');
      button.disabled = true;

      try {
        await fetch(`/cart/${article.dataset.itemId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
            Accept: 'application/json',
        },
          body: JSON.stringify({ action: button.dataset.action }),
        });
        window.location.reload();
      } catch (error) {
        console.error('No se pudo actualizar el carrito:', error);
        button.disabled = false;
      }
    });
  });
</script>
