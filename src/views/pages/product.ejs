<% if (product) { %>
	<section class="product-detail-section" aria-labelledby="product-title">
		<div class="product-detail-shell">
			<div class="product-gallery">
				<% product.images.forEach((image, index) => { %>
					<img src="<%= image %>" alt="<%= product.name %>" class="product-detail-image<%= index === 0 ? ' product-detail-image-main' : '' %>" />
				<% }) %>
			</div>

			<div class="product-detail-copy">
				<p class="eyebrow"><%= product.category %></p>
				<h1 id="product-title"><%= product.name %></h1>
				<p class="product-detail-price"><%= formatPoints(product.price) %> Puntos</p>
				<p class="product-detail-description"><%= product.description %></p>
				<form action="<%= action %>" method="post">
					<input type="hidden" name="productId" value="<%= product.id %>" />
					<button class="button" type="submit"><%= submitLabel %></button>
				</form>
				<a class="back-link" href="<%= backHref %>"><%= backLabel %></a>
			</div>
		</div>
	</section>

	<% if (relatedProducts && relatedProducts.length) { %>
		<section class="recommendations-section" aria-labelledby="related-title">
			<h2 class="section-title" id="related-title">También puede interesarte</h2>
			<div class="products-grid">
				<% relatedProducts.forEach(relatedProduct => { %>
					<%- include('../partials/productCard', { product: relatedProduct }) %>
				<% }) %>
			</div>
		</section>
	<% } %>
<% } else { %>
	<section class="product-error-section" aria-labelledby="product-error-title">
		<p class="eyebrow">Error 404</p>
		<h1 id="product-error-title">No encontramos ese producto</h1>
		<p class="intro">El enlace puede estar desactualizado o el producto ya no estar disponible.</p>
		<a class="button product-error-button" href="/">Volver al inicio</a>
	</section>

	<section class="recommendations-section" aria-labelledby="suggested-title">
		<h2 class="section-title" id="suggested-title">Quizás también te interese</h2>
		<div class="products-grid">
			<% suggestedProducts.forEach(suggestedProduct => { %>
				<%- include('../partials/productCard', { product: suggestedProduct }) %>
			<% }) %>
		</div>
	</section>
<% } %>

<section class="categories-section" aria-labelledby="product-categories-title">
	<h2 class="section-title" id="product-categories-title">Explora por categoría</h2>
	<ul class="category-list">
		<% categories.forEach(category => { %>
			<li><a href="/?category=<%= encodeURIComponent(category) %>"><%= category %></a></li>
		<% }) %>
	</ul>
</section>
