<% const isRegistration = typeof registration !== 'undefined' && registration; %>
<section class="auth-section" aria-labelledby="<%= headingId %>">
  <div class="auth-card">
    <p class="eyebrow"><%= brand %></p>
    <h1 id="<%= headingId %>"><%= heading %></h1>
    <p class="intro"><%= intro %></p>

    <form action="<%= action %>" method="post">
      <div class="form-field">
        <% if (isRegistration) { %>
          <label for="<%= nameId %>">Nombre</label>
          <input
            id="<%= nameId %>"
            name="name"
            type="text"
            autocomplete="name"
            required
          />
        <% } %>
      </div>

      <div class="form-field">
        <label for="<%= usernameId %>"><%= usernameLabel %></label>
        <input
          id="<%= usernameId %>"
          name="username"
          type="<%= isRegistration ? 'email' : 'text' %>"
          autocomplete="<%= isRegistration ? 'email' : 'username' %>"
          required
        />
      </div>

      <div class="form-field">
        <label for="<%= passwordId %>">Contraseña</label>
        <input
          id="<%= passwordId %>"
          name="password"
          type="password"
          autocomplete="<%= isRegistration ? 'new-password' : 'current-password' %>"
          required
        />
      </div>

      <button class="button" type="submit"><%= submitLabel %></button>
    </form>

    <% if (isRegistration) { %>
      <p class="auth-links">
        <a href="<%= secondaryHref %>"><%= secondaryLabel %></a>
      </p>
    <% } %>

    <a class="back-link" href="<%= backHref %>"><%= backLabel %></a>
  </div>
</section>
