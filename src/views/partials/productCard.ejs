<style>
  .product-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  .product-card-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .product-card-body {
    padding: 20px;
  }

  .product-card-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 8px;
  }

  .product-card-desc {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 16px;
    line-height: 1.5;
  }

  .product-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .product-card-price {
    font-size: 1.4rem;
    font-weight: 800;
    color: #e94560;
  }

  .product-card-btn {
    padding: 10px 20px;
    background: #1a1a2e;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .product-card-btn:hover {
    background: #0f3460;
  }

  .product-card-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }
</style>

<article class="product-card">
  <a href="/product/<%= product.id %>">
    <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="product-card-img" />
  </a>
  <div class="product-card-body">
    <h3 class="product-card-name"><a href="/product/<%= product.id %>"><%= product.name %></a></h3>
    <p class="product-card-desc"><%= product.description %></p>
    <div class="product-card-footer">
      <span class="product-card-price"><%= formatPoints(product.price) %> Puntos</span>
      <a class="product-card-btn" href="/product/<%= product.id %>">Ver detalle</a>
    </div>
  </div>
</article>
