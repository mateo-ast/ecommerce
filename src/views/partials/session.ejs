<div class="nav-session">
  <button class="session-toggle" aria-label="Cuenta" onclick="this.parentElement.classList.toggle('is-open')">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
  </button>
  <div class="session-dropdown">
    <a href="/login" class="session-dropdown-item">Iniciar sesión</a>
    <a href="/register" class="session-dropdown-item">Registrarse</a>
  </div>
</div>
<script>
document.addEventListener('click', function(e) {
  var session = document.querySelector('.nav-session');
  if (session && !session.contains(e.target)) {
    session.classList.remove('is-open');
  }
});
</script>
